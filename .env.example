# Required SERVER-ONLY Vercel environment settings. Never use NEXT_PUBLIC_ names.
# Fine-grained GitHub token: this repository only, Contents read and write.
GITHUB_STORAGE_TOKEN=
# Shared workspace password for all three partners; at least 12 characters.
WORKSPACE_PASSWORD=
# Optional; defaults to MHadiX/wrapnwhim. A dedicated private data repo is also supported.
# GITHUB_STORAGE_REPOSITORY=MHadiX/wrapnwhim
